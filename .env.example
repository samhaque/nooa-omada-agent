# Copy to .env and fill in. Never commit the real .env.

# Required: in-cluster or firewall-internal URL of the Kourier route fronting
# the KServe InferenceService, e.g. one of:
#   http://nemotron-lightning-predictor.<namespace>.svc.cluster.local/v1
#   https://nemotron-lightning-predictor-<namespace>.apps.<cluster-domain>/v1
NEMOTRON_BASE_URL=

# Served model name exactly as the NIM reports it (check with:
#   curl $NEMOTRON_BASE_URL/models
# and read .id from the response — NIM serves whatever the model card names,
# which does not always match the marketing name).
NEMOTRON_MODEL_NAME=nvidia/nemotron-lightning-30b-a3b

# No-auth on-prem endpoints still need a non-empty string for the OpenAI SDK's
# Authorization header; NIM ignores it. Leave as-is unless your deployment
# actually enforces a key.
NEMOTRON_API_KEY=not-needed

# Qwen-coder chat template thinking toggle. "true"/"false" (case-insensitive).
# Some servers (LM Studio, at least as of 2026-09) don't honor this and
# always emit reasoning tokens regardless — if so, NEMOTRON_MAX_TOKENS below
# is what actually keeps tool calls working, not this toggle.
NEMOTRON_ENABLE_THINKING=true

# Output token budget. Reasoning models spend tokens on <think> content
# before the actual tool call/response; too low and the model exhausts its
# budget mid-thought with nothing left to call a tool with (nooa raises
# GenerationError: "Empty response... used all available output tokens on
# reasoning"). 16384 is a safe floor for a reasoning model in a tool-calling
# loop; raise it if you still hit that error.
NEMOTRON_MAX_TOKENS=16384

# Optional: path to the omada-controller-mcp checkout the agent launches as
# an MCP subprocess. Defaults to a sibling directory ("../omada-controller-mcp"
# relative to this repo), only needed if yours lives somewhere else. That repo
# has its own OMADA_CLIENT_ID/OMADA_CLIENT_SECRET setup, see its README.
OMADA_MCP_DIR=
